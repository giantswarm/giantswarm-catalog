{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "auth": {
            "type": "object",
            "additionalProperties": true
        },
        "baseDomain": {
            "type": "string"
        },
        "bootstrapMode": {
            "type": "object",
            "additionalProperties": true
        },
        "chartOperator": {
            "type": "object",
            "additionalProperties": true
        },
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "ingress": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "additionalPeers": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "required": [
                                    "namespace",
                                    "matchLabels"
                                ],
                                "additionalProperties": false,
                                "properties": {
                                    "matchLabels": {
                                        "type": "object",
                                        "additionalProperties": {
                                            "type": "string"
                                        },
                                        "minProperties": 1
                                    },
                                    "namespace": {
                                        "type": "string",
                                        "minLength": 1
                                    }
                                }
                            }
                        },
                        "authentication": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "mode": {
                                    "type": "string",
                                    "enum": [
                                        "",
                                        "disabled",
                                        "required"
                                    ]
                                }
                            }
                        },
                        "clients": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                    "matchLabels": {
                                        "type": "object",
                                        "additionalProperties": {
                                            "type": "string"
                                        }
                                    },
                                    "namespace": {
                                        "type": "string"
                                    }
                                }
                            }
                        },
                        "metricsScrapers": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "required": [
                                    "namespace",
                                    "matchLabels"
                                ],
                                "additionalProperties": false,
                                "properties": {
                                    "matchLabels": {
                                        "type": "object",
                                        "additionalProperties": {
                                            "type": "string"
                                        },
                                        "minProperties": 1
                                    },
                                    "namespace": {
                                        "type": "string",
                                        "minLength": 1
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "cluster": {
            "type": "object",
            "additionalProperties": true
        },
        "clusterCA": {
            "type": "string"
        },
        "clusterCIDR": {
            "type": "string"
        },
        "clusterDNSIP": {
            "type": "string"
        },
        "clusterID": {
            "type": "string"
        },
        "enabled": {
            "type": "boolean",
            "description": "Read by a parent chart that lists valkey as a dependency with `condition: valkey.enabled` (giantswarm-repo-manager, the fleet bases): Helm hands the subchart the key it switched on, and the closed schema would refuse it. This chart itself does not read it."
        },
        "externalDNSIP": {
            "type": "string"
        },
        "gcpProject": {
            "type": "string"
        },
        "global": {
            "type": [
                "object",
                "null"
            ],
            "description": "Global values shared between all subcharts and the platform.",
            "additionalProperties": true,
            "properties": {
                "podSecurityStandards": {
                    "type": "object",
                    "additionalProperties": true
                }
            }
        },
        "helm": {
            "type": "object",
            "additionalProperties": true
        },
        "managementCluster": {
            "type": "string"
        },
        "provider": {
            "type": "string"
        },
        "subscriptionID": {
            "type": "string"
        },
        "valkey": {
            "type": "object",
            "additionalProperties": true
        },
        "vpa": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "containerPolicies": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "minAllowed": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "enabled": {
                    "type": "boolean"
                },
                "updateMode": {
                    "type": "string",
                    "enum": [
                        "Off",
                        "Initial",
                        "Recreate",
                        "InPlaceOrRecreate",
                        "Auto"
                    ]
                }
            }
        }
    }
}
