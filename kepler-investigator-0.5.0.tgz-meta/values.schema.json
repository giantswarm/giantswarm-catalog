{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "authToken": {
            "type": "object",
            "properties": {
                "existingSecret": { "type": "string" },
                "tokenKey": { "type": "string" }
            }
        },
        "config": {
            "type": "object",
            "properties": {
                "listenAddr": { "type": "string" },
                "maxRetries": { "type": "string" },
                "mcName": { "type": "string" },
                "registryRepo": { "type": "string" },
                "retryInterval": { "type": "string" },
                "slackSearchWindow": { "type": "string" },
                "tektonNamespace": { "type": "string" }
            }
        },
        "image": {
            "type": "object",
            "properties": {
                "pullPolicy": { "type": "string" },
                "repository": { "type": "string" },
                "tag": { "type": "string" }
            }
        },
        "llm": {
            "type": "object",
            "properties": {
                "apiBaseURL": { "type": "string" },
                "model": { "type": "string" },
                "provider": { "type": "string" }
            }
        },
        "llmAuth": {
            "type": "object",
            "properties": {
                "existingSecret": { "type": "string" },
                "apiKeyKey": { "type": "string" }
            }
        },
        "ociAuth": {
            "type": "object",
            "properties": {
                "existingSecret": { "type": "string" },
                "passwordKey": { "type": "string" },
                "usernameKey": { "type": "string" }
            }
        },
        "replicaCount": { "type": "integer" },
        "resources": {
            "type": "object",
            "properties": {
                "limits": {
                    "type": "object",
                    "properties": {
                        "memory": { "type": "string" }
                    }
                },
                "requests": {
                    "type": "object",
                    "properties": {
                        "cpu": { "type": "string" },
                        "memory": { "type": "string" }
                    }
                }
            }
        },
        "rules": { "type": "string" },
        "serviceAccount": {
            "type": "object",
            "properties": {
                "create": { "type": "boolean" },
                "name": { "type": "string" }
            }
        },
        "slackAuth": {
            "type": "object",
            "properties": {
                "existingSecret": { "type": "string" },
                "botTokenKey": { "type": "string" }
            }
        },
        "slackChannelID": { "type": "string" }
    }
}
