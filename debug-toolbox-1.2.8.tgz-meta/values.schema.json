{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "affinity": {
            "type": "object",
            "additionalProperties": false
        },
        "baseDomain": {
            "type": "string"
        },
        "bootstrapMode": {
            "type": "object",
            "additionalProperties": true
        },
        "chartOperator": {
            "type": "object",
            "additionalProperties": true
        },
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": true
        },
        "cluster": {
            "type": "object",
            "additionalProperties": true
        },
        "clusterCA": {
            "type": "string"
        },
        "clusterCIDR": {
            "type": "string"
        },
        "clusterDNSIP": {
            "type": "string"
        },
        "clusterID": {
            "type": "string"
        },
        "extraHostPaths": {
            "type": "array"
        },
        "gcpProject": {
            "type": "string"
        },
        "global": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "podSecurityStandards": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enforced": {
                            "type": "boolean"
                        },
                        "extraRules": {
                            "type": "array"
                        }
                    }
                }
            }
        },
        "hostIPC": {
            "type": "boolean"
        },
        "hostNetwork": {
            "type": "boolean"
        },
        "hostPID": {
            "type": "boolean"
        },
        "image": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "debugContainerImage": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "name": {
                            "type": "string"
                        },
                        "tag": {
                            "type": "string"
                        }
                    }
                },
                "pauseContainerImage": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "name": {
                            "type": "string"
                        },
                        "tag": {
                            "type": "number"
                        }
                    }
                },
                "registry": {
                    "type": "string"
                }
            }
        },
        "masterOnly": {
            "type": "boolean"
        },
        "nodeSelector": {
            "type": "object",
            "additionalProperties": false
        },
        "policyExceptionNamespace": {
            "type": "string"
        },
        "priorityClassName": {
            "type": "string"
        },
        "provider": {
            "type": "string"
        },
        "rbac": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "rules": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "apiGroup": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "resource": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "verbs": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "resources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "limits": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                },
                "requests": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "securityContext": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "allowPrivilegeEscalation": {
                    "type": "boolean"
                },
                "capabilities": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "add": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "runAsGroup": {
                    "type": "integer"
                },
                "runAsUser": {
                    "type": "integer"
                }
            }
        },
        "subscriptionID": {
            "type": "string"
        },
        "tolerations": {
            "type": "array"
        }
    }
}
