                "leaderElection": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Enables/Disables the leader election of the operator controller manager."
                        }
                    }
                },
                "logLevel": {
                    "type": "integer",
                    "description": "The level of log of the controller manager. Zero corresponds to `info`, while values greater or equal than 1 corresponds to higher debug levels. **Must be >= 0**."
                },
                "nameOverride": {
                    "type": "string"
                },
                "nodeSelector": {
                    "type": "object",
                    "description": "Sets the nodeSelector config of the operator Pod.",
                    "additionalProperties": false
                },
                "podAnnotations": {
                    "type": "object",
                    "description": "Sets the annotations of the operator Pod.",
                    "additionalProperties": false
                },
                "podSecurityContext": {
                    "type": "object",
                    "description": "Sets the security context of the operator Pod.",
                    "additionalProperties": false,
                    "properties": {
                        "runAsNonRoot": {
                            "type": "boolean"
                        }
                    }
                },
                "replicaCount": {
                    "type": "integer",
                    "description": "Number of replicas of the controller manager Pod."
                },
                "resources": {
                    "type": "object",
                    "description": "Sets the resource limits and requests of the operator controller manager container.",
                    "additionalProperties": false,
                    "properties": {
                        "limits": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        },
                        "requests": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "securityContext": {
                    "type": "object",
                    "description": "Sets the security context of the operator container.",
                    "additionalProperties": false,
                    "properties": {
                        "allowPrivilegeEscalation": {
                            "type": "boolean"
                        },
                        "capabilities": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "drop": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            }
                        },
                        "privileged": {
                            "type": "boolean"
                        },
                        "readOnlyRootFilesystem": {
                            "type": "boolean"
                        },
                        "runAsGroup": {
                            "type": "integer"
                        },
                        "runAsNonRoot": {
                            "type": "boolean"
                        },
                        "runAsUser": {
                            "type": "integer"
                        },
                        "seccompProfile": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "type": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "tolerations": {
                    "type": "array",
                    "description": "Sets the tolerations of the operator Pod."
                },
                "webhookCertIssuerInstall": {
                    "type": "boolean",
                    "description": "Set to true in non GS clusters"
                },
                "webhookCertIssuerName": {
                    "type": "string"
                }
            }
        },
        "provider": {
            "type": "string"
        },
        "registry": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
